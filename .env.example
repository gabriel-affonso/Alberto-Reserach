# Alberto runtime paths
ALBERTO_HOME=~/.alberto
ALBERTO_DB=~/.alberto/alberto.sqlite3
ALBERTO_PROJECTS_DIR=./projects
ALBERTO_TIMEZONE=Europe/Lisbon

# Optional Zotero integration. Never commit real credentials.
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_LIBRARY_ID=

# Optional email delivery. Local digest saving works without these.
ALBERTO_EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Optional subject/body delivery uses the digest generated by `alberto research digest`.

# Optional API keys for providers that support authenticated higher limits.
SEMANTIC_SCHOLAR_API_KEY=
